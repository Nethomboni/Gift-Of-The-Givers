@{
    ViewData["Title"] = "About Us";
}

<div class="page-header">
    <div class="container">
        <p class="eyebrow mb-2">Who We Are</p>
        <h1>About Gift of the Givers</h1>
        <p class="text-muted-soft mb-0" style="max-width:40rem;">Restoring Hope. Saving Lives.</p>
    </div>
</div>

<div class="container" style="max-width:760px;">
    <p>
        The Gift of the Givers Foundation stands as a beacon of hope in times of crisis, dedicated to
        providing swift and effective aid to communities struck by natural disasters and emergencies in
        South Africa and beyond.
    </p>
    <p>
        Established in response to the growing need for organised relief efforts, the foundation operates
        on the principles of compassion, efficiency, and resilience. With a diverse team of volunteers and
        experts, we strive to make a tangible difference in the lives of those affected by adversity.
    </p>
</div>

<div class="container mt-4">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card-surface p-4 h-100">
                <div class="rounded-icon mb-3"><i class="bi bi-bullseye"></i></div>
                <h4>Our Mission</h4>
                <p class="text-muted-soft mb-0">
                    To deliver rapid, dignified humanitarian relief to communities affected by disaster,
                    conflict, and hardship - regardless of race, religion, or geography.
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-surface p-4 h-100">
                <div class="rounded-icon mb-3"><i class="bi bi-eye-fill"></i></div>
                <h4>Our Vision</h4>
                <p class="text-muted-soft mb-0">
                    A world where every community has the support it needs to recover, rebuild, and thrive
                    after crisis - powered by a global network of donors and volunteers.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5 pt-3">
    <div class="section-heading text-center mx-auto mb-4" style="max-width:40rem;">
        <p class="eyebrow">What Drives Us</p>
        <h2>Our Core Values</h2>
    </div>
    <div class="row g-4">
        <div class="col-sm-6 col-lg-4">
            <div class="value-card text-center">
                <div class="rounded-icon mx-auto mb-3"><i class="bi bi-heart-fill"></i></div>
                <h5>Compassion</h5>
                <p class="text-muted-soft mb-0">We treat every person we serve with dignity, empathy, and care.</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="value-card text-center">
                <div class="rounded-icon mx-auto mb-3"><i class="bi bi-shield-check"></i></div>
                <h5>Integrity</h5>
                <p class="text-muted-soft mb-0">We're transparent and accountable in how we use every donation.</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="value-card text-center">
                <div class="rounded-icon mx-auto mb-3"><i class="bi bi-lightning-charge-fill"></i></div>
                <h5>Efficiency</h5>
                <p class="text-muted-soft mb-0">We mobilise quickly so help reaches people when it matters most.</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="value-card text-center">
                <div class="rounded-icon mx-auto mb-3"><i class="bi bi-people-fill"></i></div>
                <h5>Community</h5>
                <p class="text-muted-soft mb-0">We work alongside communities, not just for them.</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="value-card text-center">
                <div class="rounded-icon mx-auto mb-3"><i class="bi bi-tree-fill"></i></div>
                <h5>Resilience</h5>
                <p class="text-muted-soft mb-0">We help communities recover stronger, not just survive.</p>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="value-card text-center">
                <div class="rounded-icon mx-auto mb-3"><i class="bi bi-globe-americas"></i></div>
                <h5>Humanitarian Focus</h5>
                <p class="text-muted-soft mb-0">Aid goes wherever it's needed most, without discrimination.</p>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5 pt-3 mb-5">
    <div class="section-heading text-center mx-auto mb-4" style="max-width:40rem;">
        <p class="eyebrow">Our Relief Approach</p>
        <h2>From First Response to Recovery</h2>
    </div>
    <div class="row g-4">
        <div class="col-md-3 col-6">
            <div class="text-center">
                <div class="rounded-icon mx-auto mb-3"><i class="bi bi-1-circle-fill"></i></div>
                <h6>Assess</h6>
                <p class="text-muted-soft small mb-0">Rapid needs assessment on the ground.</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="text-center">
                <div class="rounded-icon mx-auto mb-3"><i class="bi bi-2-circle-fill"></i></div>
                <h6>Mobilise</h6>
                <p class="text-muted-soft small mb-0">Volunteers and resources deployed fast.</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="text-center">
                <div class="rounded-icon mx-auto mb-3"><i class="bi bi-3-circle-fill"></i></div>
                <h6>Deliver</h6>
                <p class="text-muted-soft small mb-0">Aid reaches affected communities directly.</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="text-center">
                <div class="rounded-icon mx-auto mb-3"><i class="bi bi-4-circle-fill"></i></div>
                <h6>Rebuild</h6>
                <p class="text-muted-soft small mb-0">Long-term recovery and community support.</p>
            </div>
        </div>
    </div>
</div>
