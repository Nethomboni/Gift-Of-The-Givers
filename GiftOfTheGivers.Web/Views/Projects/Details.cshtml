@model GiftOfTheGivers.Web.Models.Project
@{
    ViewData["Title"] = Model.Name;
}

<div class="breadcrumb-bar">
    <div class="container">
        <a asp-controller="Home" asp-action="Index">Home</a> /
        <a asp-controller="Projects" asp-action="Index">Projects</a> /
        <span>@Model.Name</span>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="project-tile-art mb-4" style="height:280px; border-radius:12px;">
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge-soft badge-soft-amber"><i class="bi bi-geo-alt-fill me-1"></i>@Model.Location</span>
                @if (Model.Status == "Completed")
                {
                    <span class="badge-soft badge-soft-teal">Completed</span>
                }
                else
                {
                    <span class="badge-soft badge-soft-terracotta">Ongoing</span>
                }
                <span class="badge-soft badge-soft-neutral"><i class="bi bi-people-fill me-1"></i>@Model.Beneficiaries.ToString("N0") beneficiaries</span>
            </div>

            <h1>@Model.Name</h1>
            <p class="text-muted-soft">@Model.Description</p>

            <div class="card-surface p-4 mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-semibold">R@Model.RaisedAmount.ToString("N0") raised</span>
                    <span class="text-muted-soft">of R@Model.TargetAmount.ToString("N0") target</span>
                </div>
                <div class="progress mb-3" style="height:12px;">
                    <div class="progress-bar" role="progressbar" style="width:@(Model.ProgressPercentage)%"
                         aria-valuenow="@Model.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <a asp-controller="Donation" asp-action="Index" class="btn btn-danger">
                    <i class="bi bi-heart-fill me-2"></i>Donate to This Project
                </a>
            </div>

            <h4 class="mb-3">Project Updates</h4>
            @{
                var updates = Model.Updates.OrderByDescending(u => u.CreatedAt).ToList();
            }
            @if (!updates.Any())
            {
                <div class="empty-state card-surface">
                    <i class="bi bi-megaphone"></i>
                    No project updates have been posted yet.
                </div>
            }
            else
            {
                <div class="dashboard-panel">
                    <div class="panel-body">
                        @foreach (var update in updates)
                        {
                            <div class="d-flex mb-4">
                                <div class="rounded-icon me-3 flex-shrink-0"><i class="bi bi-megaphone-fill"></i></div>
                                <div>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <h6 class="mb-0">@update.Title</h6>
                                        <span class="text-muted-soft small">@update.CreatedAt.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <p class="text-muted-soft mb-1">@update.Description</p>
                                    @if (!string.IsNullOrWhiteSpace(update.PostedByName))
                                    {
                                        <span class="text-muted-soft small"><i class="bi bi-person-badge me-1"></i>Posted by @update.PostedByName</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card-surface p-4">
                <h6 class="mb-3">Project Snapshot</h6>
                <div class="review-row"><span class="label">Status</span><span class="value">@Model.Status</span></div>
                <div class="review-row"><span class="label">Location</span><span class="value">@Model.Location</span></div>
                <div class="review-row"><span class="label">Beneficiaries</span><span class="value">@Model.Beneficiaries.ToString("N0")</span></div>
                <div class="review-row"><span class="label">Progress</span><span class="value">@Model.ProgressPercentage%</span></div>
                <a asp-controller="Projects" asp-action="Index" class="btn btn-brand-outline w-100 mt-3">
                    <i class="bi bi-arrow-left me-2"></i>All Projects
                </a>
            </div>
        </div>
    </div>
</div>
