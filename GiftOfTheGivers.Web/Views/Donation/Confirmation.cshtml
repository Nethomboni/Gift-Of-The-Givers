@model GiftOfTheGivers.Web.Models.Donation
@{
    ViewData["Title"] = "Donation Confirmation";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 text-center mb-4">
            <div class="rounded-icon mx-auto mb-3" style="width:72px; height:72px; font-size:2rem; background: var(--success-soft); color: var(--teal);">
                <i class="bi bi-check-lg"></i>
            </div>
            <h1>Thank You for Your Donation!</h1>
            <p class="text-muted-soft">Your support helps us reach communities in crisis faster.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="receipt-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="eyebrow">Donation Receipt</span>
                        <h4 class="mb-0">@Model.ReferenceNumber</h4>
                    </div>
                    <span class="badge-soft badge-soft-teal"><i class="bi bi-check-circle-fill me-1"></i>Confirmed</span>
                </div>

                <div class="review-row"><span class="label">Donor</span><span class="value">@Model.DisplayName</span></div>
                <div class="review-row"><span class="label">Amount</span><span class="value">@Model.Currency @Model.Amount.ToString("N2")</span></div>
                <div class="review-row">
                    <span class="label">Donation Type</span>
                    <span class="value">@(Model.DonationType == "Recurring" ? $"Recurring ({Model.Frequency})" : "One-Time")</span>
                </div>
                <div class="review-row"><span class="label">Cause</span><span class="value">@Model.Cause</span></div>
                <div class="review-row"><span class="label">Date</span><span class="value">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span></div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4 justify-content-center">
                <a asp-controller="Donation" asp-action="Certificate" asp-route-reference="@Model.ReferenceNumber" class="btn btn-brand-outline">
                    <i class="bi bi-file-earmark-text me-2"></i>View Tax Certificate
                </a>
                <a asp-controller="Donation" asp-action="Certificate" asp-route-reference="@Model.ReferenceNumber" asp-route-download="true" class="btn btn-brand-outline">
                    <i class="bi bi-download me-2"></i>Download Tax Certificate
                </a>
                <a asp-controller="Donation" asp-action="Index" class="btn btn-danger">
                    <i class="bi bi-arrow-repeat me-2"></i>Donate Again
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-brand-outline">
                    <i class="bi bi-house-fill me-2"></i>Return Home
                </a>
            </div>
        </div>
    </div>
</div>
