@using Microsoft.AspNetCore.Identity
@using GiftOfTheGivers.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var isEmployee = false;
    var displayName = User.Identity?.Name ?? "";

    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            displayName = currentUser.FullName;
            isEmployee = await UserManager.IsInRoleAsync(currentUser, "Employee");
        }
    }
}

@if (SignInManager.IsSignedIn(User))
{
    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle me-1"></i> @displayName
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenu">
                @if (isEmployee)
                {
                    <li><h6 class="dropdown-header">Employee</h6></li>
                    <li><a class="dropdown-item" asp-controller="Employee" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Employee Dashboard</a></li>
                    <li><a class="dropdown-item" asp-controller="Employee" asp-action="ProjectUpdates"><i class="bi bi-megaphone me-2"></i>Project Updates</a></li>
                    <li><a class="dropdown-item" asp-controller="Employee" asp-action="Volunteers"><i class="bi bi-people me-2"></i>Volunteer Sign-ups</a></li>
                }
                else
                {
                    <li><h6 class="dropdown-header">Donor</h6></li>
                    <li><a class="dropdown-item" asp-controller="Donor" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                }
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                        <button type="submit" class="btn btn-sm btn-brand-outline w-100 text-start"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav align-items-lg-center">
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
        <li class="nav-item ms-lg-2">
            <a class="btn btn-danger btn-sm" asp-controller="Account" asp-action="Register">Register</a>
        </li>
    </ul>
}
