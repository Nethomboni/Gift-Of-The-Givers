@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container my-5 text-center">
    <div class="rounded-icon mx-auto mb-3" style="width:72px; height:72px; font-size:2rem; background: var(--danger-soft); color: var(--terracotta);">
        <i class="bi bi-exclamation-triangle-fill"></i>
    </div>
    <h1>Something Went Wrong</h1>
    <p class="text-muted-soft mx-auto" style="max-width:34rem;">
        We hit an unexpected error while processing your request. Please try again, and if the problem
        continues, let us know via the Contact page.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted-soft small">Request ID: <code>@Model.RequestId</code></p>
    }

    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-danger">
            <i class="bi bi-house-fill me-2"></i>Return Home
        </a>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-brand-outline">
            <i class="bi bi-envelope-fill me-2"></i>Contact Support
        </a>
    </div>
</div>
