@model GiftOfTheGivers.Web.Models.Volunteer
@{
    ViewData["Title"] = "Volunteer Confirmation";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 text-center mb-4">
            <div class="rounded-icon mx-auto mb-3" style="width:72px; height:72px; font-size:2rem; background: var(--success-soft); color: var(--teal);">
                <i class="bi bi-check-lg"></i>
            </div>
            <h1>You're Registered!</h1>
            <p class="text-muted-soft">
                Thank you for registering your interest in volunteering with Gift of the Givers.
                Our team will be in touch when there's a fit for your skills.
            </p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="receipt-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="eyebrow">Volunteer Reference</span>
                        <h4 class="mb-0">@Model.ReferenceNumber</h4>
                    </div>
                    <span class="badge-soft badge-soft-teal"><i class="bi bi-check-circle-fill me-1"></i>@Model.Status</span>
                </div>

                <div class="review-row"><span class="label">Name</span><span class="value">@Model.FullName</span></div>
                <div class="review-row"><span class="label">Skills</span><span class="value">@Model.Skills</span></div>
                <div class="review-row"><span class="label">Availability</span><span class="value">@Model.Availability</span></div>
                <div class="review-row"><span class="label">Submitted</span><span class="value">@Model.SubmittedAt.ToString("dd MMM yyyy, HH:mm")</span></div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4 justify-content-center">
                <a asp-controller="Donation" asp-action="Index" class="btn btn-danger">
                    <i class="bi bi-heart-fill me-2"></i>Consider Donating Too
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-brand-outline">
                    <i class="bi bi-house-fill me-2"></i>Return Home
                </a>
            </div>
        </div>
    </div>
</div>
