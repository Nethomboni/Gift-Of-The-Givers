@{
    ViewData["Title"] = "Access Denied";
}

<div class="container my-5 text-center">
    <div class="rounded-icon mx-auto mb-3" style="width:72px; height:72px; font-size:2rem; background: var(--danger-soft); color: var(--terracotta);">
        <i class="bi bi-shield-lock-fill"></i>
    </div>
    <h1>Access Denied</h1>
    <p class="text-muted-soft mx-auto" style="max-width:34rem;">
        You don't have permission to view this page. If you think this is a mistake, please log in with the
        correct account for the section you're trying to reach.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-danger mt-2">
        <i class="bi bi-house-fill me-2"></i>Return Home
    </a>
</div>
