@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<div class="list-group dashboard-quicknav">
    <a asp-controller="Employee" asp-action="Dashboard" class="list-group-item list-group-item-action @(currentAction == "Dashboard" ? "active" : "")">
        <i class="bi bi-speedometer2 me-2"></i>Dashboard
    </a>
    <a asp-controller="Employee" asp-action="ProjectUpdates" class="list-group-item list-group-item-action @(currentAction == "ProjectUpdates" ? "active" : "")">
        <i class="bi bi-megaphone me-2"></i>Project Updates
    </a>
    <a asp-controller="Employee" asp-action="Volunteers" class="list-group-item list-group-item-action @(currentAction == "Volunteers" ? "active" : "")">
        <i class="bi bi-people me-2"></i>Volunteer Sign-ups
    </a>
    <a asp-controller="Projects" asp-action="Index" class="list-group-item list-group-item-action">
        <i class="bi bi-folder2 me-2"></i>All Projects
    </a>
</div>
