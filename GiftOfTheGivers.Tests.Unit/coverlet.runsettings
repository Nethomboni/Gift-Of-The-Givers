<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<DataCollectionRunSettings>
		<DataCollectors>
			<DataCollector friendlyName="XPlat Code Coverage">
				<Configuration>
					<Format>cobertura</Format>
					<Include>[GiftOfTheGivers.Web]*</Include>
					<Exclude>[GiftOfTheGivers.Web]AspNetCoreGeneratedDocument.*</Exclude>
					<ExcludeByFile>**/Program.cs,**/Data/SeedData.cs,**/Migrations/**</ExcludeByFile>
				</Configuration>
			</DataCollector>
		</DataCollectors>
	</DataCollectionRunSettings>
</RunSettings>